use Slang::Quotes;

my $planet = 'earth';

say "hello, $planet";   # "normal" double quotes
say ❝hello, $planet❞;   # heavy double comma quotation marks
say 🙶hello, $planet🙷 ;  # sans-serif heavy double comma quotation marks
say ❛hello, $planet❜;   # heavy single comma quotation marks
say 〝hello, $planet〞; # double prime quotation marks
say ＂hello, $planet＂; # fullwidth quotation marks

